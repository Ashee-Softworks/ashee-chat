# The model host, as the documentation states it. Copy this file to `.env.local` and change
# it there; `.env*` is ignored and this example is the only one committed.
#
# Nothing here is secret, which is the point of committing it: the configuration is a host
# and a port on this machine, and the file exists so that the shape of the configuration is
# visible without any real value being published.

# Where the model server is listening. Ollama's default.
OLLAMA_HOST=http://127.0.0.1:11434

# How long one generation may take before the request is abandoned, in seconds.
# A cold 32B model on an 8-core host can take a while to produce its first token.
OLLAMA_TIMEOUT_SECONDS=300

# The model selected when the interface opens, if it is installed.
DEFAULT_MODEL=qwen2.5-coder:0.5b
